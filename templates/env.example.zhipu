# 智谱（bigmodel.cn）RAG 配置模板
#
# 用法：复制本书稿根目录下 → 改名 .env → 填入真实 key
#   cp .env.example.zhipu .env
#
# 端点：https://open.bigmodel.cn/api/paas/v4
# key 在 https://bigmodel.cn/usercenter/apikeys 获取

# ---------- Embedding（必需） ----------
EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBED_MODEL=embedding-3
EMBED_API_KEY=在这里填你的智谱 API Key

# 向量维度：256 / 512 / 1024 / 2048（留空则用服务端默认 2048）
# 长篇检索推荐 1024 —— 精度够用，体积只有 2048 的一半。
# 600 章规模实测：2048 维约 30MB 索引，1024 维约 15MB，召回质量无明显差别。
EMBED_DIM=1024

# 单条送入 embedding 的最大字符数。
# 智谱 embedding-3 单条上限 3072 token（中文约 2000 字），超出会静默截断且不报错。
# 留 1800 字余量，避免"检索不到末尾信息"这种难查的坑。
EMBED_MAX_CHARS=1800

# ---------- Rerank（强烈建议配） ----------
# 向量余弦只能算语义相似度，区分不出"提到了但不重要"和"这才是主角要的"。
# rerank 才是真正决定排名的最后一道关。
# 成本 0.8 元/百万 token，而单次检索只送 20~30 条候选，单章开销约 0.001 元。
RERANK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RERANK_MODEL=rerank
# 留空则复用 EMBED_API_KEY（同一个智谱 key，一般不用单独填）
RERANK_API_KEY=
# 送入 rerank 的候选条数上限，超过部分在客户端截断
RERANK_MAX_DOCS=50

# ============ 成本估算 ============
# embedding-3: 0.5 元/百万 token
# rerank:0.8 元/百万 token
#
# 建索引（一次性，600 章约 90 万 token）      ≈ 0.45 元
# 单章检索（1 次 embedding 查询 + 20 条 rerank） ≈ 0.001 元
# 写 600 章全程：建索引 0.45 + 检索 0.6        ≈ 1 元
#
# 结论：成本可以忽略。Batch API 还能再打 5 折，
# 但建索引只需一次，不值得为它增加复杂度。